#!/usr/bin/env python3
"""Test stub for `claude -p --output-format stream-json`. Behaviour:
- Reads the prompt from stdin.
- Records argv and the prompt as JSON to $PR_TEST_CLAUDE_LOG, if set.
- Replays the lines of $PR_TEST_CLAUDE_TRANSCRIPT to stdout one at a time.
- Fires the hooks from `--settings` the way claude would: SubagentStart first,
  PreToolUse before each replayed tool_use block, SubagentStop at the end.
- Exits with $PR_TEST_CLAUDE_EXIT (default 0).
"""
import json
import os
import shlex
import sys

argv = sys.argv[1:]
prompt = sys.stdin.read()

log = os.environ.get("PR_TEST_CLAUDE_LOG")
if log:
    with open(log, "w") as f:
        json.dump({"argv": argv, "prompt": prompt}, f)


def _hook_path():
    if "--settings" not in argv:
        return None
    settings = json.loads(argv[argv.index("--settings") + 1])
    command = settings["hooks"]["PreToolUse"][0]["hooks"][0]["command"]
    return shlex.split(command)[-1]


def _fire(record):
    path = _hook_path()
    if path:
        with open(path, "a") as f:
            f.write(json.dumps(record) + "\n")


def _debug(text):
    if "--debug-file" in argv:
        with open(argv[argv.index("--debug-file") + 1], "a") as f:
            f.write(f"2026-01-01T00:00:00.000Z [DEBUG] {text}\n")


transcript = os.environ.get("PR_TEST_CLAUDE_TRANSCRIPT")
if transcript:
    _fire({"hook_event_name": "SubagentStart", "agent_id": "a1", "agent_type": "general-purpose"})
    with open(transcript) as f:
        for line in f:
            event = json.loads(line)
            if event.get("type") == "assistant":
                _debug("[API REQUEST] /v1/messages x-client-request-id=fake")
                _debug("[API:timing] first byte after 100ms")
                for block in event["message"].get("content", []):
                    if block.get("type") == "tool_use":
                        _fire({"hook_event_name": "PreToolUse", "tool_name": block["name"],
                               "tool_use_id": block.get("id"), "tool_input": block.get("input")})
            sys.stdout.write(line)
            sys.stdout.flush()
    _fire({"hook_event_name": "SubagentStop", "agent_id": "a1", "agent_type": "general-purpose"})

sys.exit(int(os.environ.get("PR_TEST_CLAUDE_EXIT", "0")))
